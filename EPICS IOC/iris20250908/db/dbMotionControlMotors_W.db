record(ao, "mc:m:motor:$(MOTOR):$(TYPE)") {
    field(DESC, $(DESCRIZIONE))
    field(DTYP, "asynInt32")
    field(OUT, "@asyn($(PORT_W), $(REG), 2000)INT32_BE")
    field(SCAN, Passive)
    field(PINI, "YES")
}
